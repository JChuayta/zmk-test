#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        mt: mod_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        alpha {
            display-name = "QWERTY";

            // -----------------------------------------------------------------------------------------
            // | LT3 |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // |S+TAB|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | DEL  |
            // | CTL |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |S+CAPS|
            //                    | GUI | MO1 | SPC |   | SPC |LT2ENT| ALT |

            bindings = <
&lt 3 ESCAPE   &kp Q    &kp W    &kp E       &kp R    &kp T        &kp Y    &kp U       &kp I       &kp O    &kp P        &kp BSPC
&mt LSHIFT TAB &kp A    &kp S    &kp D       &kp F    &kp G        &kp H    &kp J       &kp K       &kp L    &kp SCLN     &kp DEL
&kp LCTRL      &kp Z    &kp X    &kp C       &kp V    &kp B        &kp N    &kp M       &kp COMMA   &kp DOT  &kp SLASH    &mt RSHIFT CAPS
                                 &kp LGUI    &mo 1    &kp SPACE    &kp SPACE &lt 2 ENTER &kp RALT
            >;
        };

        navigate {
            display-name = "NAVIGATE";

            // -----------------------------------------------------------------------------------------
            // |  F1 |  F2 |  F3 |  F4 |  F5 |  F6 |   |  F7 |  F8  |  F9  | F10 | F11 | F12 |
            // |S+TAB|     |SHIFT|CTRL |GUI  |ALT  |   |BRID |BRIU  |  UP  |PSCR |HOME |END  |
            // | CTL |PREV |NEXT |MUTE |MPLY |VOL- |   |VOL+ | LEFT | DOWN |RIGHT|PGUP |PGDN |
            //                    | GUI | MO1 | SPC |   | SPC | MO4  | ALT  |

            bindings = <
&kp F1           &kp F2       &kp F3       &kp F4       &kp F5         &kp F6           &kp F7           &kp F8           &kp F9      &kp F10      &kp F11      &kp F12
&mt LSHIFT TAB   &trans       &kp LSHIFT   &kp LCTRL    &kp LGUI       &kp LALT         &trans           &trans           &kp UP      &kp PSCRN    &kp HOME     &kp END
&kp LCTRL        &kp C_PREV   &kp C_NEXT   &kp C_MUTE   &kp C_PLAY_PAUSE &kp C_VOL_DN   &kp C_VOL_UP     &kp LEFT         &kp DOWN    &kp RIGHT    &kp PAGE_UP  &kp PAGE_DOWN
                                           &kp LGUI     &trans         &kp SPACE       &kp SPACE        &mo 4            &kp RALT
            >;
        };

        symbols {
            display-name = "SYMBOLS";

            // -----------------------------------------------------------------------------------------
            // | | |  !  |  @  |  #  |  $  |  %  |   |  &  |  /  |  (  |  )  |  =  | BKSP |
            // |S+TAB| " |  ' |  <  |  >  |  +  |   |  *  |  ~  |  [  |  ]  |  `  | DEL  |
            // | CTL |    |    |  \  |  ^  |  -  |   |  ?  |  _  |     |     |     | RSFT |
            //                    | GUI | MO3 | SPC |   | SPC |TRANS| ALT |

            bindings = <
&kp PIPE         &kp EXCL      &kp AT        &kp HASH    &kp DLAR   &kp PERCENT      &kp AMPERSAND   &kp SLASH        &kp LPAR      &kp RPAR      &kp EQUAL       &kp BSPC
&mt LSHIFT TAB   &kp DQUO      &kp SINGLE_QUOTE &kp LT   &kp GT     &kp PLUS         &kp ASTERISK    &kp TILD         &kp LBRC      &kp RBRC      &kp GRAVE       &kp DEL
&kp LCTRL        &trans        &trans        &kp BACKSLASH &kp CARET &kp MINUS        &kp QUESTION    &kp UNDER        &trans        &trans        &trans          &kp RSHIFT
                                             &kp LGUI    &mo 3      &kp SPACE        &kp SPACE       &trans           &kp RALT
            >;
        };

        numbers {
            display-name = "NUMBERS";

            // -----------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |   |  +  |  1  |  2  |  3  |  -  | BKSP |
            // |     |     |     |     |     |     |   |  *  |  4  |  5  |  6  |  =  | DEL  |
            // |     |     |     |     |     |     |   |     |  7  |  8  |  9  |  0  |      |
            //                    | GUI |TRANS| SPC |   | ENT |TRANS| ALT |

            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans       &kp PLUS      &kp N1  &kp N2  &kp N3  &kp MINUS &kp BSPC
&trans  &trans  &trans  &trans  &trans  &trans       &kp ASTERISK  &kp N4  &kp N5  &kp N6  &kp EQUAL &kp DEL
&trans  &trans  &trans  &trans  &trans  &trans       &trans        &kp N7  &kp N8  &kp N9  &kp N0    &trans
                        &kp LGUI &trans &kp SPACE    &kp ENTER     &trans  &kp RALT
            >;
        };

        adjust {
            display-name = "ADJUST";

            // -----------------------------------------------------------------------------------------
            // |BOOT |     |     |     |     |     |   |     |     |     |     |     |      |
            // |     |     |     |     |     |     |   |     |     |     |     |     |      |
            // |     |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |TRANS| SPC |   | ENT |TRANS| ALT |

            bindings = <
&bootloader  &trans  &trans  &trans  &trans  &trans       &trans      &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans       &trans      &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans  &trans  &trans       &trans      &trans  &trans  &trans  &trans  &trans
                             &kp LGUI &trans &kp SPACE    &kp ENTER   &trans  &kp RALT
            >;
        };

    };
};
